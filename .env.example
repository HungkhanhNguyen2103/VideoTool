# Set to production when running the built app (serves dist/client). Default: development
# NODE_ENV=production
PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=video_tool
FILES_DIR=./data/files
REMOTION_PUBLIC_DIR=./data/remotion-public
WORKER_POLL_MS=2000

# AI providers: server/worker only, never expose to the client
AI_TEXT_API_KEY=
AI_IMAGE_API_KEY=
AI_TTS_API_KEY=
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=
DEFAULT_AI_PROVIDER=deepseek
TTS_API_URL=http://127.0.0.1:8000/api/tts
TTS_DEFAULT_VOICE=Truc Ly
TTS_REF_AUDIO_PATH=./lib/speech/audio.WAV
TTS_REF_AUDIO_TEXT=Ai cũng biết Quang Trung là người đánh tan 29 vạn quân Thanh chỉ trong 5 ngày tết.
TTS_TIMEOUT_MS=60000
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
FREESOUND_API_KEY=
