{
  "name": "video-tool",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -n web,api,worker -c cyan,green,yellow \"vite\" \"tsx watch --env-file=.env src/server/main.ts\" \"tsx watch --env-file=.env src/worker/main.ts\"",
    "build": "vite build && tsup",
    "start": "node --env-file=.env dist/server.js",
    "start:worker": "node --env-file=.env dist/worker.js",
    "typecheck": "tsc -p tsconfig.server.json && tsc -p tsconfig.client.json",
    "lint": "eslint src",
    "test": "vitest run"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.103.2",
    "express": "^5.2.1",
    "mongodb": "^7.6.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "ulid": "^3.0.2",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "eslint": "^10.11.0",
    "mongodb-memory-server": "^11.3.0",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
